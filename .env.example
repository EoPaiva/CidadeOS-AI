# CidadeOS AI — Fase 1
# Copie para .env localmente se quiser alterar valores.
# Nunca coloque secrets reais em GitHub, zip público, README ou frontend.

PORT=3333
HOST=0.0.0.0
APP_NAME=CidadeOS AI
APP_URL=http://localhost:3333
AUTH_SECRET=troque-este-valor-em-producao
MAX_JSON_SIZE_MB=8


# ===============================
# Deploy Preview / Vercel
# ===============================
APP_ENV=preview
APP_URL=http://localhost:3333
PUBLIC_DEMO_MODE=true

# Futuro banco externo
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=COLE_AQUI_APENAS_CHAVE_PUBLICA_ANONIMA
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_APENAS_NO_BACKEND_NUNCA_NO_FRONTEND
SUPABASE_STORAGE_BUCKET=occurrence-attachments

# Segurança futura em produção
JWT_SECRET=troque-por-um-segredo-forte
COOKIE_SECRET=troque-por-outro-segredo-forte
ENCRYPTION_KEY=32-caracteres-ou-chave-forte-para-criptografia

# WhatsApp Business real por cidade/cliente
WHATSAPP_WEBHOOK_BASE_URL=https://seu-projeto.vercel.app
META_APP_SECRET=opcional-no-backend

# ===============================
# Fase 2.3 — Supabase compartilhado
# ===============================
# Na Vercel, use estas variáveis em Project Settings > Environment Variables.
# DATABASE_URL deve usar Transaction Pooler quando possível (porta 6543).
CIDADEOS_DEFAULT_CITY_SLUG=cidade-modelo

# CidadeOS AI — anexos/evidências
CIDADEOS_ATTACHMENT_BUCKET=occurrence-attachments
CIDADEOS_MAX_ATTACHMENT_BYTES=5242880

WHATSAPP_GRAPH_VERSION=v20.0

WHATSAPP_MEDIA_BUCKET=occurrence-attachments
WHATSAPP_VALIDATE_SIGNATURE=false
